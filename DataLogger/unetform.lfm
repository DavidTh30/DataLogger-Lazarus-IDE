object NetForm: TNetForm
  Left = 400
  Height = 540
  Top = 100
  Width = 460
  BorderStyle = bsDialog
  Caption = 'Network Config'
  ClientHeight = 540
  ClientWidth = 460
  Position = poMainFormCenter
  object RadioProto: TRadioGroup
    Left = 12
    Height = 90
    Top = 8
    Width = 436
    AutoFill = True
    Caption = ' Protocol '
    ChildSizing.LeftRightSpacing = 6
    ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
    ChildSizing.EnlargeVertical = crsHomogenousChildResize
    ChildSizing.ShrinkHorizontal = crsScaleChilds
    ChildSizing.ShrinkVertical = crsScaleChilds
    ChildSizing.Layout = cclLeftToRightThenTopToBottom
    ChildSizing.ControlsPerLine = 1
    ClientHeight = 70
    ClientWidth = 432
    ItemIndex = 0
    Items.Strings = (
      'S7 TCP/IP (Siemens S7-1200 / 1500 / 300 / 400)'
      'Modbus TCP/IP'
      'Modbus RTU (RS485)'
    )
    OnClick = RadioProtoClick
    TabOrder = 0
  end
  object GroupTcp: TGroupBox
    Left = 12
    Height = 58
    Top = 104
    Width = 436
    Caption = ' TCP/IP '
    ClientHeight = 38
    ClientWidth = 432
    TabOrder = 1
    object LabelHost: TLabel
      Left = 10
      Height = 15
      Top = 10
      Width = 56
      Caption = 'IP address'
    end
    object EditHost: TEdit
      Left = 80
      Height = 23
      Top = 6
      Width = 170
      TabOrder = 0
      Text = '192.168.0.1'
    end
    object LabelPort: TLabel
      Left = 270
      Height = 15
      Top = 10
      Width = 22
      Caption = 'Port'
    end
    object SpinPort: TSpinEdit
      Left = 304
      Height = 23
      Top = 6
      Width = 110
      MaxValue = 65535
      MinValue = 1
      TabOrder = 1
      Value = 502
    end
  end
  object GroupS7: TGroupBox
    Left = 12
    Height = 58
    Top = 166
    Width = 436
    Caption = ' S7 '
    ClientHeight = 38
    ClientWidth = 432
    TabOrder = 2
    object LabelRack: TLabel
      Left = 10
      Height = 15
      Top = 10
      Width = 24
      Caption = 'Rack'
    end
    object SpinRack: TSpinEdit
      Left = 80
      Height = 23
      Top = 6
      Width = 70
      MaxValue = 7
      TabOrder = 0
    end
    object LabelSlot: TLabel
      Left = 170
      Height = 15
      Top = 10
      Width = 116
      Caption = 'Slot (S7-1200/1500 = 1)'
    end
    object SpinSlot: TSpinEdit
      Left = 304
      Height = 23
      Top = 6
      Width = 110
      MaxValue = 31
      TabOrder = 1
      Value = 1
    end
  end
  object GroupId: TGroupBox
    Left = 12
    Height = 58
    Top = 228
    Width = 436
    Caption = ' Modbus '
    ClientHeight = 38
    ClientWidth = 432
    TabOrder = 3
    object LabelUnit: TLabel
      Left = 10
      Height = 15
      Top = 10
      Width = 39
      Caption = 'Unit ID'
    end
    object SpinUnit: TSpinEdit
      Left = 80
      Height = 23
      Top = 6
      Width = 70
      MaxValue = 255
      TabOrder = 0
      Value = 1
    end
  end
  object GroupSerial: TGroupBox
    Left = 12
    Height = 92
    Top = 290
    Width = 436
    Caption = ' RS485 serial port '
    ClientHeight = 72
    ClientWidth = 432
    TabOrder = 4
    object LabelCom: TLabel
      Left = 10
      Height = 15
      Top = 10
      Width = 22
      Caption = 'Port'
    end
    object ComboCom: TComboBox
      Left = 80
      Height = 23
      Top = 6
      Width = 100
      ItemHeight = 15
      TabOrder = 0
      Text = 'COM1'
    end
    object LabelBaud: TLabel
      Left = 200
      Height = 15
      Top = 10
      Width = 27
      Caption = 'Baud'
    end
    object ComboBaud: TComboBox
      Left = 244
      Height = 23
      Top = 6
      Width = 100
      ItemHeight = 15
      Items.Strings = (
        '1200'
        '2400'
        '4800'
        '9600'
        '19200'
        '38400'
        '57600'
        '115200'
      )
      TabOrder = 1
      Text = '9600'
    end
    object LabelData: TLabel
      Left = 10
      Height = 15
      Top = 44
      Width = 46
      Caption = 'Data bits'
    end
    object ComboData: TComboBox
      Left = 80
      Height = 23
      Top = 40
      Width = 50
      ItemHeight = 15
      Items.Strings = (
        '7'
        '8'
      )
      Style = csDropDownList
      TabOrder = 2
    end
    object LabelParity: TLabel
      Left = 146
      Height = 15
      Top = 44
      Width = 31
      Caption = 'Parity'
    end
    object ComboParity: TComboBox
      Left = 186
      Height = 23
      Top = 40
      Width = 80
      ItemHeight = 15
      Items.Strings = (
        'None'
        'Even'
        'Odd'
      )
      Style = csDropDownList
      TabOrder = 3
    end
    object LabelStop: TLabel
      Left = 282
      Height = 15
      Top = 44
      Width = 47
      Caption = 'Stop bits'
    end
    object ComboStop: TComboBox
      Left = 340
      Height = 23
      Top = 40
      Width = 50
      ItemHeight = 15
      Items.Strings = (
        '1'
        '2'
      )
      Style = csDropDownList
      TabOrder = 4
    end
  end
  object GroupGeneral: TGroupBox
    Left = 12
    Height = 100
    Top = 386
    Width = 436
    Caption = ' General '
    ClientHeight = 80
    ClientWidth = 432
    TabOrder = 5
    object LabelTimeout: TLabel
      Left = 10
      Height = 15
      Top = 10
      Width = 74
      Caption = 'Timeout (ms)'
    end
    object SpinTimeout: TSpinEdit
      Left = 110
      Height = 23
      Top = 6
      Width = 90
      Increment = 100
      MaxValue = 30000
      MinValue = 100
      TabOrder = 0
      Value = 1000
    end
    object CheckAutoMonitor: TCheckBox
      Left = 10
      Height = 19
      Top = 36
      Width = 230
      Caption = 'Start Monitor when the program opens'
      TabOrder = 1
    end
    object CheckAutoRecord: TCheckBox
      Left = 10
      Height = 19
      Top = 56
      Width = 230
      Caption = 'Start Record when the program opens'
      TabOrder = 2
    end
  end
  object ButtonPanel1: TButtonPanel
    Left = 6
    Height = 34
    Top = 500
    Width = 448
    OKButton.Name = 'OKButton'
    OKButton.DefaultCaption = True
    HelpButton.Name = 'HelpButton'
    HelpButton.DefaultCaption = True
    CloseButton.Name = 'CloseButton'
    CloseButton.DefaultCaption = True
    CancelButton.Name = 'CancelButton'
    CancelButton.DefaultCaption = True
    TabOrder = 6
    ShowButtons = [pbOK, pbCancel]
  end
end
