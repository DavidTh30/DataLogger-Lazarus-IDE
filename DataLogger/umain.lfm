    object LabelConn: TLabel
      Left = 30
      Height = 16
      Top = 7
      Width = 440
      AutoSize = False
      Caption = 'Stopped'
    end
    object ShapeRec: TShape
      Left = 478
      Height = 16
      Top = 7
      Width = 16
      Brush.Color = clSilver
      Shape = stCircle
    end
    object LabelRec: TLabel
      Left = 500
      Height = 16
      Top = 7
      Width = 312
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'not recording'
      Font.Style = [fsBold]
      ParentFont = False
    end
  end
  object GridTags: TStringGrid
    Left = 0
    Height = 334
    Top = 72
