object MainForm: TMainForm
  Left = 300
  Height = 470
  Top = 120
  Width = 820
  Caption = 'PLC Data Logger'
  ClientHeight = 450
  ClientWidth = 820
  Constraints.MinHeight = 360
  Constraints.MinWidth = 560
  Menu = MainMenu1
  Position = poScreenCenter
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object PanelTop: TPanel
    Left = 0
    Height = 42
    Top = 0
    Width = 820
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 42
    ClientWidth = 820
    TabOrder = 0
    object BtnMonitor: TButton
      Left = 8
      Height = 30
      Hint = 'Read the PLC and show the values (no file)'
      Top = 6
      Width = 100
      Caption = 'Monitor'
      OnClick = BtnMonitorClick
      ParentShowHint = False
      ShowHint = True
      TabOrder = 0
    end
    object BtnRecord: TButton
      Left = 114
      Height = 30
      Hint = 'Read the PLC and write a CSV row every interval'
      Top = 6
      Width = 110
      Caption = 'Record'
      Font.Color = clMaroon
      Font.Style = [fsBold]
      OnClick = BtnRecordClick
      ParentFont = False
      ParentShowHint = False
      ShowHint = True
      TabOrder = 1
    end
    object BtnStop: TButton
      Left = 230
      Height = 30
      Top = 6
      Width = 90
      Caption = 'Stop'
      OnClick = BtnStopClick
      TabOrder = 2
    end
    object LabelInterval: TLabel
      Left = 340
      Height = 15
      Top = 14
      Width = 44
      Caption = 'Interval'
    end
    object SpinInterval: TSpinEdit
      Left = 392
      Height = 23
      Hint = 'Time between two records (default 500 ms, minimum 5 ms)'
      Top = 10
      Width = 80
      Increment = 100
      MaxValue = 600000
      MinValue = 5
      OnChange = SpinIntervalChange
      ParentShowHint = False
      ShowHint = True
      TabOrder = 3
      Value = 500
    end
    object LabelMs: TLabel
      Left = 478
      Height = 15
      Top = 14
      Width = 17
      Caption = 'ms'
    end
  end
  object PanelStatus: TPanel
    Left = 0
    Height = 30
