  object PanelModbus: TPanel
    Left = 8
    Height = 130
    Top = 32
    Width = 424
    BevelOuter = bvNone
    ClientHeight = 130
    ClientWidth = 424
    TabOrder = 1
    Visible = False
    object LabelTable: TLabel
      Left = 4
      Height = 15
