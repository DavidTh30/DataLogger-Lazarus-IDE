    end
    object ComboMType: TComboBox
      Left = 110
      Height = 23
      Top = 64
      Width = 230
      ItemHeight = 15
      Items.Strings = (
        'INT (1 register)'
        'UINT (1 register)'
        'DINT (2 registers)'
