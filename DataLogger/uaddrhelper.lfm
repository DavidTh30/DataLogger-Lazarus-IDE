      Caption = 'Table'
    end
    object ComboTable: TComboBox
      Left = 110
      Height = 23
      Top = 4
      Width = 260
      ItemHeight = 15
      Items.Strings = (
        '0x  Coil  (FC01, read/write bit)'
        '1x  Discrete input  (FC02, read-only bit)'
